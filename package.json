{
  "name": "xray-monorepo",
  "private": true,
  "description": "X-ray vision for any codebase: an interactive, zoomable map of architecture, calls and dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orgalorg7/xray-codebase.git"
  },
  "homepage": "https://github.com/orgalorg7/xray-codebase#readme",
  "bugs": {
    "url": "https://github.com/orgalorg7/xray-codebase/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "bench": "pnpm build && pnpm --filter @xray/bench bench",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
