{
  "name": "@xray/analysis",
  "version": "0.0.0",
  "description": "Graph analyses for xray: cycles, impact, call tracing, feature search, metrics, districts and layout. Browser-safe; git history lives in @xray/analysis/git (Node).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./git": {
      "development": "./src/git.ts",
      "types": "./dist/git.d.ts",
      "default": "./dist/git.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@xray/schema": "workspace:*",
    "d3-hierarchy": "3.1.2"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "3.1.7",
    "@xray/engine": "workspace:*",
    "@xray/store": "workspace:*",
    "@xray/testkit": "workspace:*"
  }
}
