    "architecture",
    "dependency-graph",
    "call-graph",
    "code-map",
    "circular-dependencies",
    "impact-analysis",
    "visualization",
    "static-analysis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orgalorg7/xray-codebase.git",
    "directory": "packages/xray-codebase"
  },
  "homepage": "https://github.com/orgalorg7/xray-codebase#readme",
  "bugs": {
    "url": "https://github.com/orgalorg7/xray-codebase/issues"
  },
  "type": "module",
  "bin": {
    "xray": "dist/xray.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
